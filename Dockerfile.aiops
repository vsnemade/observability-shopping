# Python AIOps service — separate Dockerfile because the root one is the Maven multi-stage
# build for the Java services.
#
# Two stages: build the React dashboard with Node, then copy only its compiled
# output (dist/) into the Python runtime image. Node itself never ships.

FROM node:22-slim AS frontend-build
WORKDIR /frontend
COPY services/aiops-service/frontend/package.json services/aiops-service/frontend/package-lock.json* ./
RUN npm install
COPY services/aiops-service/frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY services/aiops-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/aiops-service/app ./app
# FastAPI serves this directory at "/" — see the StaticFiles mount in app/main.py.
COPY --from=frontend-build /frontend/dist ./app/static

EXPOSE 8090
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8090"]
